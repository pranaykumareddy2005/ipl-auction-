# Copy to .env and fill in. .env is gitignored.
# Supabase Session Pooler (IPv4-compatible — required on IPv4-only VPS).
# Dashboard → Project Settings → Database → Connection string → Session pooler.
PGHOST=aws-0-<region>.pooler.supabase.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres.<your-project-ref>
PGPASSWORD=your-database-password
PGSSL=require
PORT=3000
# Set to 1 when behind a reverse proxy (nginx/Caddy) for correct client IPs.
TRUST_PROXY=1
